{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Engine controls are available to the bundled llama.cpp server in the main window.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:18080/*"] },
  "permissions": [
    "core:default",
    "allow-open-chat",
    "allow-manager-call",
    "allow-list-models",
    "allow-read-engine-config",
    "allow-save-engine-config",
    "allow-open-trt-guide",
    "allow-window-action",
    "allow-get-app-paths",
    "allow-save-app-paths",
    "allow-pick-folders",
    "allow-pick-folder",
    "allow-list-log-files",
    "allow-read-log-file",
    "allow-open-logs-folder"
  ]
}
